# GymPerformance member web surface — local development
# Copy to .env.local and fill in values (do not commit .env.local).

# Supabase project API URL (e.g. https://<project-ref>.supabase.co)
GYMPERF_SUPABASE_URL=

# Supabase publishable (anon) key — safe for client-side use; RLS enforces access
GYMPERF_SUPABASE_PUBLISHABLE_KEY=

# Stub broker (DEV ONLY). Set to true + TEST_DEVICE_MEMBER_ID to mint without
# real TeamUp OAuth. Forbidden in production builds (stub-broker-guard).
# GYMPERF_USE_STUB_BROKER=true
# TEST_DEVICE_MEMBER_ID=

# Runtime secrets for the Cloudflare Worker / local Nitro SSR (NOT baked into
# the client bundle). Put SESSION_SECRET in `.dev.vars` for `vite`/`wrangler
# dev`, and set it on the Worker with:
#   wrangler secret put SESSION_SECRET
# Must be ≥ 32 characters (h3 iron seal password).
# SESSION_SECRET=
