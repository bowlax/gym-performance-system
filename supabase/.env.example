SUPABASE_URL=http://127.0.0.1:54321
SERVICE_ROLE_KEY=<service-role-key>
# Local/dev stub HS256 mint only (OAuth unconfigured). Not used when OAuth is live.
# Omit from deployed secrets once OAuth is configured.
JWT_SIGNING_SECRET=<jwt-signing-secret>

# Optional — enable real TeamUp OAuth (all four required together).
# When set, stub-token POSTs are rejected (403); use authorize/callback instead.
# TEAMUP_OAUTH_CLIENT_ID=<teamup-oauth-client-id>
# TEAMUP_OAUTH_CLIENT_SECRET=<teamup-oauth-client-secret>
# TEAMUP_OAUTH_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/token-broker?oauth=callback
# TEAMUP_OAUTH_PROVIDER_ID=<teamup-provider-id>
#
# Per-surface exact-match return URL allowlists (comma-separated). Client
# returnUrl on authorize is accepted only if it matches an entry exactly.
# Shipped clients today: ios + memberWeb.
# TEAMUP_OAUTH_ALLOWED_RETURN_URLS_IOS=gymperformance://connect
# TEAMUP_OAUTH_ALLOWED_RETURN_URLS_MEMBER_WEB=http://localhost:5173/auth/callback,https://gymperf-member-web.<account>.workers.dev/auth/callback
# Reserved until coach/owner web ship (broker already accepts these surfaces):
# TEAMUP_OAUTH_ALLOWED_RETURN_URLS_COACH_WEB=
# TEAMUP_OAUTH_ALLOWED_RETURN_URLS_OWNER_WEB=
#
# Deprecated — unused for return-url resolution (allowlists above replace it):
# TEAMUP_OAUTH_SUCCESS_REDIRECT_URI=
#
# TEAMUP_OAUTH_SCOPE=read_write provider:<teamup-provider-id>
# TEAMUP_OAUTH_AUTHORIZE_URL=https://goteamup.com/api/v2/auth/oauth/authorize
# TEAMUP_OAUTH_TOKEN_URL=https://goteamup.com/api/v2/auth/oauth/token
#
# Required when TeamUp OAuth is configured. Dedicated HMAC for OAuth `state` —
# must NOT be the Supabase project JWT secret / JWT_SIGNING_SECRET.
# OAUTH_STATE_SECRET=<random-32+-byte-secret>
